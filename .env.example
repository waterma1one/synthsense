# ── LLM — groq.com (free tier available) ─────────────────────────────────────
GROQ_API_KEY=gsk_your_key_here

# ── Multimodal + Embeddings — huggingface.co (Settings > Access Tokens) ──────
HUGGINGFACE_API_KEY=hf_your_key_here

# ── Vector DB — supabase.com (new project → Settings → API) ──────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_service_role_key_here

# ── Cache — upstash.com (new Redis DB → REST API) ────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# ── Observability — smith.langchain.com (free account) ───────────────────────
LANGCHAIN_API_KEY=lsv2_pt_your_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=synthsense

# ── Optional overrides ────────────────────────────────────────────────────────
# GROQ_MODEL=llama-3.1-8b-instant
# LOG_LEVEL=INFO
# EVAL_EVERY_N_INCIDENTS=10
